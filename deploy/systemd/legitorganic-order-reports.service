[Unit]
Description=Retry pending Legit Organic owner order reports
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=legitorganic
Group=legitorganic
WorkingDirectory=/var/www/legitorganic/backend
ExecStart=/var/www/legitorganic/backend/venv/bin/python manage.py retry_order_reports

[Install]
WantedBy=multi-user.target
