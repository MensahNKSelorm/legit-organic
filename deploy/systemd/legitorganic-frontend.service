[Unit]
Description=Legit Organic Next.js Frontend
After=network.target

[Service]
User=legitorganic
Group=legitorganic
WorkingDirectory=/var/www/legitorganic/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
