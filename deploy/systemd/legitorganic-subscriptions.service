[Unit]
Description=Process Legit Organic subscription renewals and scheduled price changes
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=legitorganic
Group=legitorganic
WorkingDirectory=/var/www/legitorganic/backend
ExecStart=/var/www/legitorganic/backend/venv/bin/python manage.py process_subscription_payments
ExecStart=/var/www/legitorganic/backend/venv/bin/python manage.py process_subscription_price_changes

[Install]
WantedBy=multi-user.target
