[Unit]
Description=Legit Organic Django Backend
After=network.target

[Service]
User=legitorganic
Group=legitorganic
WorkingDirectory=/var/www/legitorganic/backend
Environment="PATH=/var/www/legitorganic/backend/venv/bin"
RuntimeDirectory=legitorganic
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/var/www/legitorganic/backend/venv/bin/gunicorn --workers 3 --bind unix:/run/legitorganic/gunicorn.sock --umask 007 legitorganic.wsgi:application
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
