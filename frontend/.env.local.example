NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
# Cloudflare Turnstile public site key. Leave unset to disable the signup
# challenge (dev / pre-provisioning). The matching secret goes in the backend
# .env as TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
